{
  "NODE_ENV": "production",
  "HOST": "127.0.0.1",
  "PORT": 3000,
  "MCP_PATH": "/mcp",
  "PUBLIC_BASE_URL": "https://mcp.example.com",
  "LOG_LEVEL": "info",
  "DATABASE_PATH": "./data/database.sqlite",
  "BACKUP_DIRECTORY": "./data/backups",
  "AUTH_MODE": "api_key",
  "ALLOWED_ORIGINS": [
    "localhost",
    "127.0.0.1",
    "[::1]",
    "mcp.example.com"
  ],
  "ALLOWED_HOSTS": [
    "localhost",
    "127.0.0.1",
    "[::1]",
    "mcp.example.com"
  ],
  "ALLOWED_GUILD_IDS": [],
  "CORS_ENABLED": true,
  "TRUST_PROXY": false,
  "SESSION_MODE": "stateless",
  "SESSION_TTL": 1800,
  "MAX_REQUEST_SIZE": 1048576,
  "RATE_LIMIT_ENABLED": true,
  "REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE": true,
  "ENABLE_AUDIT_HISTORY": true
}

