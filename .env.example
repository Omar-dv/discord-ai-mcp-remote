NODE_ENV=production
HOST=127.0.0.1
PORT=3000
MCP_PATH=/mcp
PUBLIC_BASE_URL=https://mcp.example.com

DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_APPLICATION_ID=

LOG_LEVEL=info
DATABASE_PATH=./data/database.sqlite
BACKUP_DIRECTORY=./data/backups

AUTH_MODE=api_key
API_KEY_HASH=
API_KEY_SCOPES=discord:read,discord:messages:read,discord:messages:write,discord:channels:read,discord:channels:write,discord:roles:read,discord:roles:write,discord:members:read,discord:members:moderate,discord:guild:manage,discord:webhooks:manage,discord:automod:manage,discord:backup:read,discord:backup:write,discord:bot:manage,discord:admin

ALLOWED_ORIGINS=localhost,127.0.0.1,[::1],mcp.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp.example.com
ALLOWED_GUILD_IDS=

CORS_ENABLED=true
TRUST_PROXY=false
SESSION_MODE=stateless
SESSION_TTL=1800
MAX_SESSIONS_PER_IDENTITY=10
MAX_TOTAL_SESSIONS=200

MAX_REQUEST_SIZE=1048576
REQUEST_TIMEOUT_MS=30000
TOOL_TIMEOUT_MS=25000
MAX_CONCURRENT_REQUESTS=50

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_IDENTITY_PER_MINUTE=120
RATE_LIMIT_TOOL_CALLS_PER_MINUTE=90
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=10
RATE_LIMIT_MAX_MESSAGES_PER_MINUTE=30
RATE_LIMIT_MAX_DESTRUCTIVE_PER_MINUTE=10

REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
ENABLE_AUDIT_HISTORY=true
AUDIT_RETENTION_DAYS=90

INTENT_GUILDS=true
INTENT_GUILD_MEMBERS=false
INTENT_GUILD_MODERATION=true
INTENT_GUILD_EMOJIS_AND_STICKERS=true
INTENT_GUILD_INTEGRATIONS=true
INTENT_GUILD_WEBHOOKS=true
INTENT_GUILD_INVITES=true
INTENT_GUILD_VOICE_STATES=true
INTENT_GUILD_PRESENCES=false
INTENT_GUILD_MESSAGES=true
INTENT_GUILD_MESSAGE_REACTIONS=true
INTENT_MESSAGE_CONTENT=false
INTENT_GUILD_SCHEDULED_EVENTS=true
INTENT_AUTO_MODERATION_CONFIGURATION=true
INTENT_AUTO_MODERATION_EXECUTION=true

OAUTH_ISSUER_URL=
OAUTH_AUDIENCE=
OAUTH_JWKS_URI=
OAUTH_TOKEN_INTROSPECTION_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ALLOW_INSECURE_ISSUER=false
